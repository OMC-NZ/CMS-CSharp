@CMS_CSharp_HostAddress = http://localhost:5089

GET {{CMS_CSharp_HostAddress}}/
Accept: application/json

###

GET {{CMS_CSharp_HostAddress}}/api/promotions/eligible?imei=123456789012345
Accept: application/json

###

POST {{CMS_CSharp_HostAddress}}/api/claims
Content-Type: multipart/form-data; boundary=ClaimBoundary

--ClaimBoundary
Content-Disposition: form-data; name="promotionId"

1
--ClaimBoundary
Content-Disposition: form-data; name="imei"

123456789012345
--ClaimBoundary
Content-Disposition: form-data; name="purchaseDate"

2026-08-25
--ClaimBoundary
Content-Disposition: form-data; name="firstName"

Example
--ClaimBoundary
Content-Disposition: form-data; name="lastName"

Customer
--ClaimBoundary
Content-Disposition: form-data; name="email"

customer@example.com
--ClaimBoundary
Content-Disposition: form-data; name="contact"

0210000000
--ClaimBoundary
Content-Disposition: form-data; name="street"

1 Example Street
--ClaimBoundary
Content-Disposition: form-data; name="suburb"

Example Suburb
--ClaimBoundary
Content-Disposition: form-data; name="city"

Auckland
--ClaimBoundary
Content-Disposition: form-data; name="postcode"

1010
--ClaimBoundary
Content-Disposition: form-data; name="instructions"

Leave at reception
--ClaimBoundary
Content-Disposition: form-data; name="giftAliases"

["GIFT-ALIAS"]
--ClaimBoundary
Content-Disposition: form-data; name="receipt"; filename="receipt.pdf"
Content-Type: application/pdf

< ./receipt.pdf
--ClaimBoundary
Content-Disposition: form-data; name="screenshot"; filename="screenshot.png"
Content-Type: image/png

< ./screenshot.png
--ClaimBoundary--

###

GET {{CMS_CSharp_HostAddress}}/health
Accept: text/plain

###

GET {{CMS_CSharp_HostAddress}}/database/status
Accept: application/json

###

GET {{CMS_CSharp_HostAddress}}/api/devices/search?market_name=Reno
Accept: application/json

###

GET {{CMS_CSharp_HostAddress}}/api/channels/search?name=Mobile
Accept: application/json

###

GET {{CMS_CSharp_HostAddress}}/api/channels
Accept: application/json

###

GET {{CMS_CSharp_HostAddress}}/api/gifts/search?name=Watch
Accept: application/json

###

# The banner and optional terms file must be selected by the HTTP client.
POST {{CMS_CSharp_HostAddress}}/api/promotions
Content-Type: multipart/form-data; boundary=PromotionBoundary

--PromotionBoundary
Content-Disposition: form-data; name="name"

OPPO Buds3 Pro for A6 5G Spark Only
--PromotionBoundary
Content-Disposition: form-data; name="description"

one (1) x OPPO Enco Buds3 Pro White
--PromotionBoundary
Content-Disposition: form-data; name="products"

[{"market_name":"A6 5G","model":"CPH2831"}]
--PromotionBoundary
Content-Disposition: form-data; name="channels"

[{"code":"SPK","startDate":"2026-09-01","endDate":"2026-09-28"}]
--PromotionBoundary
Content-Disposition: form-data; name="gifts"

[{"name":"Enco Buds3 Pro","alias":"ENCO BUDS3PRO WHITE","color":"White"}]
--PromotionBoundary
Content-Disposition: form-data; name="banner"; filename="banner.webp"
Content-Type: image/webp

< ./banner.webp
--PromotionBoundary
Content-Disposition: form-data; name="terms"

/terms
--PromotionBoundary--

###
